{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/r/:code", "destination": "/?ref=:code", "permanent": false }
  ],
  "headers": [
    { "source": "/referrals", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Cache-Control", "value": "no-store" }] }
  ]
}
